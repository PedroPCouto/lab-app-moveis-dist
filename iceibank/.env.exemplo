# Modelo do .env.local (que fica fora do Git). Copie para .env.local e preencha com os dados
# da sua instancia CloudAMQP (https://customer.cloudamqp.com/ -> instancia -> Details).
# Os scripts leem o .env.local sozinhos quando RABBITMQ_URL nao esta definida no terminal.
RABBITMQ_URL=amqps://usuario:senha@host.rmq.cloudamqp.com/vhost
RABBITMQ_HOST=host.rmq.cloudamqp.com
RABBITMQ_USUARIO=usuario
RABBITMQ_VHOST=vhost
RABBITMQ_SENHA=senha
RABBITMQ_PORTA=5672
RABBITMQ_PORTA_TLS=5671
